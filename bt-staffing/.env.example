# --- Core -------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bt_staffing?schema=public"
# Long random string used to sign login sessions. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Public base URL of this app (used in the form link that is texted to applicants)
APP_URL="http://localhost:3000"

# --- Integration switches: "mock" or "live" ------------------------------------
HUBSPOT_MODE="mock"
# HubSpot private app token (only read when HUBSPOT_MODE=live)
HUBSPOT_PRIVATE_APP_TOKEN=""
# HubSpot object that holds cases: "deals", "tickets" or a custom object type id like "2-1234567"
HUBSPOT_CASE_OBJECT="deals"

# Only mock implementations exist for these three today.
APPLOI_MODE="mock"
SALESMSG_MODE="mock"
WORKDAY_MODE="mock"

# --- Webhook / cron shared secrets ----------------------------------------------
WORKDAY_WEBHOOK_SECRET="dev-workday-secret"
SALESMSG_WEBHOOK_SECRET="dev-salesmsg-secret"
CRON_SECRET="dev-cron-secret"

# --- Behaviour --------------------------------------------------------------
# Text the form link (through the Salesmsg adapter) when intake creates a new profile.
# Set to "false" if a Salesmsg automation already sends that text.
SEND_FORM_LINK_ON_INTAKE="true"
# Require the Workday "hired" event before someone counts as Ready.
REQUIRE_WORKDAY_HIRE="true"
# Show the one-click demo account buttons on the login page. Set to "false" anywhere real.
SHOW_DEMO_LOGINS="true"
